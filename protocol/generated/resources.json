{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "resources.json",
    "$defs": {
        "BackendCapabilities": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "BackendCapabilities.json",
            "type": "object",
            "properties": {
                "provider": {
                    "$ref": "BackendProvider.json"
                },
                "engine": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "skypilot"
                        },
                        {
                            "type": "string",
                            "const": "theta_api"
                        },
                        {
                            "type": "string",
                            "const": "kubernetes"
                        },
                        {
                            "type": "string",
                            "const": "simulator"
                        }
                    ]
                },
                "allocation_modes": {
                    "type": "array",
                    "items": {
                        "anyOf": [
                            {
                                "type": "string",
                                "const": "whole_device"
                            },
                            {
                                "type": "string",
                                "const": "mig"
                            },
                            {
                                "type": "string",
                                "const": "software_shared"
                            }
                        ]
                    },
                    "minItems": 1
                },
                "supports_multi_node": {
                    "type": "boolean"
                },
                "supports_stop": {
                    "type": "boolean"
                },
                "supports_spot": {
                    "type": "boolean"
                },
                "guaranteed_notice_seconds": {
                    "$ref": "NonnegativeInteger.json"
                },
                "create_idempotency": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "native"
                        },
                        {
                            "type": "string",
                            "const": "reconcile_before_retry"
                        }
                    ]
                },
                "workload_isolation": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "owner_only"
                        },
                        {
                            "type": "string",
                            "const": "qualified_multitenant"
                        }
                    ]
                },
                "evidence": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "simulated"
                        },
                        {
                            "type": "string",
                            "const": "source_reviewed"
                        },
                        {
                            "type": "string",
                            "const": "live_verified"
                        }
                    ]
                }
            },
            "required": [
                "provider",
                "engine",
                "allocation_modes",
                "supports_multi_node",
                "supports_stop",
                "supports_spot",
                "guaranteed_notice_seconds",
                "create_idempotency",
                "workload_isolation",
                "evidence"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "BackendProvider": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "BackendProvider.json",
            "anyOf": [
                {
                    "type": "string",
                    "const": "vast"
                },
                {
                    "type": "string",
                    "const": "runpod"
                },
                {
                    "type": "string",
                    "const": "theta"
                },
                {
                    "type": "string",
                    "const": "kubernetes"
                },
                {
                    "type": "string",
                    "const": "simulator"
                }
            ]
        },
        "NonnegativeInteger": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "NonnegativeInteger.json",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
        },
        "BackendRequest": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "BackendRequest.json",
            "type": "object",
            "properties": {
                "tenant_id": {
                    "$ref": "BackendIdentifier.json"
                },
                "project_id": {
                    "$ref": "BackendIdentifier.json"
                },
                "account_id": {
                    "$ref": "BackendIdentifier.json"
                },
                "operation_id": {
                    "$ref": "BackendIdentifier.json"
                },
                "generation": {
                    "$ref": "PositiveInteger.json"
                },
                "provider": {
                    "$ref": "BackendProvider.json"
                },
                "image": {
                    "$ref": "BackendIdentifier.json"
                },
                "gpu_model": {
                    "$ref": "BackendIdentifier.json"
                },
                "gpu_count": {
                    "$ref": "PositiveInteger.json"
                },
                "num_nodes": {
                    "$ref": "PositiveInteger.json"
                },
                "region": {
                    "$ref": "BackendIdentifier.json"
                },
                "capacity_mode": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "on_demand"
                        },
                        {
                            "type": "string",
                            "const": "spot"
                        }
                    ]
                },
                "workload_trust": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "owner"
                        },
                        {
                            "type": "string",
                            "const": "untrusted"
                        }
                    ]
                },
                "max_hourly_price_microusd": {
                    "$ref": "PositiveInteger.json"
                },
                "command": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "minItems": 1
                }
            },
            "required": [
                "tenant_id",
                "project_id",
                "account_id",
                "operation_id",
                "generation",
                "provider",
                "image",
                "gpu_model",
                "gpu_count",
                "num_nodes",
                "region",
                "capacity_mode",
                "workload_trust",
                "max_hourly_price_microusd",
                "command"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "BackendIdentifier": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "BackendIdentifier.json",
            "type": "string",
            "minLength": 1,
            "maxLength": 255
        },
        "PositiveInteger": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "PositiveInteger.json",
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
        },
        "BackendObservation": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "BackendObservation.json",
            "type": "object",
            "properties": {
                "tenant_id": {
                    "$ref": "BackendIdentifier.json"
                },
                "project_id": {
                    "$ref": "BackendIdentifier.json"
                },
                "account_id": {
                    "$ref": "BackendIdentifier.json"
                },
                "operation_id": {
                    "$ref": "BackendIdentifier.json"
                },
                "provider": {
                    "$ref": "BackendProvider.json"
                },
                "resource_id": {
                    "$ref": "BackendIdentifier.json"
                },
                "generation": {
                    "$ref": "PositiveInteger.json"
                },
                "revision": {
                    "$ref": "PositiveInteger.json"
                },
                "state": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "provisioning"
                        },
                        {
                            "type": "string",
                            "const": "running"
                        },
                        {
                            "type": "string",
                            "const": "paused"
                        },
                        {
                            "type": "string",
                            "const": "lost"
                        },
                        {
                            "type": "string",
                            "const": "released"
                        },
                        {
                            "type": "string",
                            "const": "unknown"
                        }
                    ]
                },
                "supplier_state": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "allocated"
                        },
                        {
                            "type": "string",
                            "const": "released"
                        },
                        {
                            "type": "string",
                            "const": "unknown"
                        }
                    ]
                },
                "workload": {
                    "$ref": "BackendWorkloadStatus.json"
                }
            },
            "required": [
                "tenant_id",
                "project_id",
                "account_id",
                "operation_id",
                "provider",
                "resource_id",
                "generation",
                "revision",
                "state",
                "supplier_state"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "BackendWorkloadStatus": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "BackendWorkloadStatus.json",
            "type": "object",
            "properties": {
                "job_id": {
                    "$ref": "BackendIdentifier.json"
                },
                "state": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "queued"
                        },
                        {
                            "type": "string",
                            "const": "running"
                        },
                        {
                            "type": "string",
                            "const": "succeeded"
                        },
                        {
                            "type": "string",
                            "const": "failed"
                        },
                        {
                            "type": "string",
                            "const": "canceled"
                        },
                        {
                            "type": "string",
                            "const": "unknown"
                        }
                    ]
                }
            },
            "required": [
                "job_id",
                "state"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "BurstPolicy": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "BurstPolicy.json",
            "type": "object",
            "properties": {
                "mode": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "disabled"
                        },
                        {
                            "type": "string",
                            "const": "manual"
                        },
                        {
                            "type": "string",
                            "const": "automatic"
                        }
                    ]
                },
                "allowed_providers": {
                    "type": "array",
                    "items": {
                        "$ref": "BackendProvider.json"
                    }
                },
                "allowed_regions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "max_hourly_price_microusd": {
                    "$ref": "NonnegativeInteger.json"
                },
                "max_total_spend_microusd": {
                    "$ref": "NonnegativeInteger.json"
                },
                "max_concurrent_remote_jobs": {
                    "$ref": "NonnegativeInteger.json"
                },
                "local_wait_seconds": {
                    "$ref": "NonnegativeInteger.json"
                },
                "data_policy": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "local_only"
                        },
                        {
                            "type": "string",
                            "const": "artifacts_only"
                        }
                    ]
                }
            },
            "required": [
                "mode",
                "allowed_providers",
                "allowed_regions",
                "max_hourly_price_microusd",
                "max_total_spend_microusd",
                "max_concurrent_remote_jobs",
                "local_wait_seconds",
                "data_policy"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "SiteCredentialRotation": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "SiteCredentialRotation.json",
            "type": "object",
            "properties": {
                "rotation_id": {
                    "$ref": "SiteRotationId.json"
                },
                "credential": {
                    "$ref": "SiteCredential.json"
                }
            },
            "required": [
                "rotation_id",
                "credential"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "SiteRotationId": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "SiteRotationId.json",
            "type": "string",
            "pattern": "^rot_[a-f0-9]{32}(?![\\s\\S])"
        },
        "SiteCredential": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "SiteCredential.json",
            "type": "string",
            "pattern": "^vgs_[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048](?![\\s\\S])"
        },
        "SiteEnrollment": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "SiteEnrollment.json",
            "type": "object",
            "properties": {
                "site_id": {
                    "$ref": "SiteId.json"
                },
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                },
                "protocol_version": {
                    "type": "string",
                    "const": "vgpu.site.v1"
                },
                "credential": {
                    "$ref": "SiteCredential.json"
                }
            },
            "required": [
                "site_id",
                "name",
                "protocol_version",
                "credential"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "SiteId": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "SiteId.json",
            "type": "string",
            "pattern": "^sit_[a-f0-9]{32}(?![\\s\\S])"
        },
        "SiteConnection": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "SiteConnection.json",
            "type": "object",
            "properties": {
                "site_id": {
                    "$ref": "SiteId.json"
                },
                "tenant_id": {
                    "$ref": "BackendIdentifier.json"
                },
                "project_id": {
                    "$ref": "BackendIdentifier.json"
                },
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                },
                "protocol_version": {
                    "type": "string",
                    "const": "vgpu.site.v1"
                },
                "state": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "active"
                        },
                        {
                            "type": "string",
                            "const": "expired"
                        },
                        {
                            "type": "string",
                            "const": "revoked"
                        }
                    ]
                },
                "credential_expires_at": {
                    "$ref": "NonnegativeInteger.json"
                },
                "consumption_enabled": {
                    "type": "boolean",
                    "const": false
                },
                "contribution_enabled": {
                    "type": "boolean",
                    "const": false
                }
            },
            "required": [
                "site_id",
                "tenant_id",
                "project_id",
                "name",
                "protocol_version",
                "state",
                "credential_expires_at",
                "consumption_enabled",
                "contribution_enabled"
            ]
        },
        "SiteRotationResult": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "SiteRotationResult.json",
            "type": "object",
            "properties": {
                "rotation_id": {
                    "$ref": "SiteRotationId.json"
                }
            },
            "required": [
                "rotation_id"
            ],
            "allOf": [
                {
                    "$ref": "SiteConnection.json"
                }
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "ProtocolError": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "ProtocolError.json",
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
                }
            },
            "required": [
                "error"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "InterruptionScope": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "InterruptionScope.json",
            "type": "object",
            "properties": {
                "tenant_id": {
                    "$ref": "BackendIdentifier.json"
                },
                "project_id": {
                    "$ref": "BackendIdentifier.json"
                },
                "lease_id": {
                    "$ref": "BackendIdentifier.json"
                },
                "job_id": {
                    "$ref": "BackendIdentifier.json"
                },
                "attempt_id": {
                    "$ref": "BackendIdentifier.json"
                },
                "generation": {
                    "$ref": "PositiveInteger.json"
                },
                "controller_epoch": {
                    "$ref": "PositiveInteger.json"
                },
                "agent_session_id": {
                    "$ref": "InterruptionSessionId.json"
                }
            },
            "required": [
                "tenant_id",
                "project_id",
                "lease_id",
                "job_id",
                "attempt_id",
                "generation",
                "controller_epoch",
                "agent_session_id"
            ]
        },
        "InterruptionSessionId": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "InterruptionSessionId.json",
            "type": "string",
            "pattern": "^igs_[a-f0-9]{32}(?![\\s\\S])"
        },
        "InterruptionSourceNotice": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "InterruptionSourceNotice.json",
            "type": "object",
            "properties": {
                "source_id": {
                    "$ref": "BackendIdentifier.json"
                },
                "source_event_id": {
                    "$ref": "BackendIdentifier.json"
                },
                "source_revision": {
                    "$ref": "PositiveInteger.json"
                },
                "authority": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "provider"
                        },
                        {
                            "type": "string",
                            "const": "vgpu"
                        },
                        {
                            "type": "string",
                            "const": "local_owner"
                        }
                    ]
                },
                "state": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "active"
                        },
                        {
                            "type": "string",
                            "const": "withdrawn"
                        }
                    ]
                },
                "kind": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "preempt"
                        },
                        {
                            "type": "string",
                            "const": "stop"
                        },
                        {
                            "type": "string",
                            "const": "reboot"
                        },
                        {
                            "type": "string",
                            "const": "advisory"
                        }
                    ]
                },
                "reason": {
                    "$ref": "BackendIdentifier.json"
                },
                "observed_at_ms": {
                    "$ref": "NonnegativeInteger.json"
                },
                "source_time_kind": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "action_at"
                        },
                        {
                            "type": "string",
                            "const": "not_before"
                        },
                        {
                            "type": "string",
                            "const": "vgpu_policy"
                        },
                        {
                            "type": "string",
                            "const": "unknown"
                        }
                    ]
                },
                "source_action_at_ms": {
                    "anyOf": [
                        {
                            "$ref": "NonnegativeInteger.json"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "source_not_before_ms": {
                    "anyOf": [
                        {
                            "$ref": "NonnegativeInteger.json"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "release_by_ms": {
                    "anyOf": [
                        {
                            "$ref": "NonnegativeInteger.json"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "signal_at_ms": {
                    "anyOf": [
                        {
                            "$ref": "NonnegativeInteger.json"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "safety_margin_ms": {
                    "$ref": "NonnegativeInteger.json"
                },
                "clock_uncertainty_ms": {
                    "$ref": "NonnegativeInteger.json"
                },
                "mapping_policy": {
                    "$ref": "BackendIdentifier.json"
                },
                "notice_class": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "best_effort"
                        },
                        {
                            "type": "string",
                            "const": "controlled"
                        },
                        {
                            "type": "string",
                            "const": "no_notice"
                        }
                    ]
                },
                "allowed_actions": {
                    "type": "array",
                    "items": {
                        "$ref": "InterruptionAction.json"
                    },
                    "maxItems": 3
                },
                "extension_limit_ms": {
                    "anyOf": [
                        {
                            "$ref": "NonnegativeInteger.json"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "source_id",
                "source_event_id",
                "source_revision",
                "authority",
                "state",
                "kind",
                "reason",
                "observed_at_ms",
                "source_time_kind",
                "source_action_at_ms",
                "source_not_before_ms",
                "release_by_ms",
                "signal_at_ms",
                "safety_margin_ms",
                "clock_uncertainty_ms",
                "mapping_policy",
                "notice_class",
                "allowed_actions",
                "extension_limit_ms"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "InterruptionAction": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "InterruptionAction.json",
            "anyOf": [
                {
                    "type": "string",
                    "const": "ack"
                },
                {
                    "type": "string",
                    "const": "ready"
                },
                {
                    "type": "string",
                    "const": "request_extension"
                }
            ]
        },
        "Interruption": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "Interruption.json",
            "type": "object",
            "properties": {
                "schema_version": {
                    "type": "number",
                    "const": 1
                },
                "interruption_id": {
                    "$ref": "InterruptionId.json"
                },
                "version": {
                    "$ref": "PositiveInteger.json"
                },
                "phase": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "scheduled"
                        },
                        {
                            "type": "string",
                            "const": "releasing"
                        },
                        {
                            "type": "string",
                            "const": "completed"
                        },
                        {
                            "type": "string",
                            "const": "canceled"
                        }
                    ]
                },
                "source": {
                    "$ref": "InterruptionSourceNotice.json"
                },
                "release_by_ms": {
                    "anyOf": [
                        {
                            "$ref": "NonnegativeInteger.json"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "signal_at_ms": {
                    "anyOf": [
                        {
                            "$ref": "NonnegativeInteger.json"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "schema_version",
                "interruption_id",
                "version",
                "phase",
                "source",
                "release_by_ms",
                "signal_at_ms"
            ],
            "allOf": [
                {
                    "$ref": "InterruptionScope.json"
                }
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "InterruptionId": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "InterruptionId.json",
            "type": "string",
            "pattern": "^int_[a-f0-9]{32}(?![\\s\\S])"
        },
        "InterruptionSnapshot": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "InterruptionSnapshot.json",
            "type": "object",
            "properties": {
                "schema_version": {
                    "type": "number",
                    "const": 1
                },
                "cursor": {
