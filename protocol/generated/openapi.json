  "components": {
    "schemas": {
      "BackendCapabilities": {
        "type": "object",
        "required": [
          "provider",
          "engine",
          "allocation_modes",
          "supports_multi_node",
          "supports_stop",
          "supports_spot",
          "guaranteed_notice_seconds",
          "create_idempotency",
          "workload_isolation",
          "evidence"
        ],
        "properties": {
          "provider": {
            "$ref": "#/components/schemas/BackendProvider"
          },
          "engine": {
            "type": "string",
            "enum": [
              "skypilot",
              "theta_api",
              "kubernetes",
              "simulator"
            ]
          },
          "allocation_modes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "whole_device",
                "mig",
                "software_shared"
              ]
            },
            "minItems": 1
          },
          "supports_multi_node": {
            "type": "boolean"
          },
          "supports_stop": {
            "type": "boolean"
          },
          "supports_spot": {
            "type": "boolean"
          },
          "guaranteed_notice_seconds": {
            "$ref": "#/components/schemas/NonnegativeInteger"
          },
          "create_idempotency": {
            "type": "string",
            "enum": [
              "native",
              "reconcile_before_retry"
            ]
          },
          "workload_isolation": {
            "type": "string",
            "enum": [
              "owner_only",
              "qualified_multitenant"
            ]
          },
          "evidence": {
            "type": "string",
            "enum": [
              "simulated",
              "source_reviewed",
              "live_verified"
            ]
          }
        },
        "unevaluatedProperties": {
          "not": {}
        }
      },
      "BackendIdentifier": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      },
      "BackendObservation": {
        "type": "object",
        "required": [
          "tenant_id",
          "project_id",
          "account_id",
          "operation_id",
          "provider",
          "resource_id",
          "generation",
          "revision",
          "state",
          "supplier_state"
        ],
        "properties": {
          "tenant_id": {
            "$ref": "#/components/schemas/BackendIdentifier"
          },
          "project_id": {
            "$ref": "#/components/schemas/BackendIdentifier"
          },
          "account_id": {
            "$ref": "#/components/schemas/BackendIdentifier"
          },
          "operation_id": {
            "$ref": "#/components/schemas/BackendIdentifier"
          },
          "provider": {
            "$ref": "#/components/schemas/BackendProvider"
          },
          "resource_id": {
            "$ref": "#/components/schemas/BackendIdentifier"
          },
          "generation": {
            "$ref": "#/components/schemas/PositiveInteger"
          },
          "revision": {
            "$ref": "#/components/schemas/PositiveInteger"
          },
          "state": {
            "type": "string",
            "enum": [
              "provisioning",
              "running",
              "paused",
              "lost",
              "released",
              "unknown"
            ]
          },
          "supplier_state": {
            "type": "string",
            "enum": [
              "allocated",
              "released",
              "unknown"
            ]
          },
          "workload": {
            "$ref": "#/components/schemas/BackendWorkloadStatus"
          }
        },
        "unevaluatedProperties": {
          "not": {}
        }
      },
      "BackendProvider": {
        "type": "string",
        "enum": [
          "vast",
          "runpod",
          "theta",
          "kubernetes",
          "simulator"
        ]
      },
      "BackendRequest": {
        "type": "object",
        "required": [
          "tenant_id",
          "project_id",
          "account_id",
          "operation_id",
          "generation",
          "provider",
          "image",
          "gpu_model",
          "gpu_count",
          "num_nodes",
          "region",
          "capacity_mode",
          "workload_trust",
          "max_hourly_price_microusd",
          "command"
        ],
        "properties": {
          "tenant_id": {
            "$ref": "#/components/schemas/BackendIdentifier"
          },
          "project_id": {
            "$ref": "#/components/schemas/BackendIdentifier"
          },
          "account_id": {
            "$ref": "#/components/schemas/BackendIdentifier"
          },
          "operation_id": {
            "$ref": "#/components/schemas/BackendIdentifier"
          },
          "generation": {
            "$ref": "#/components/schemas/PositiveInteger"
          },
          "provider": {
            "$ref": "#/components/schemas/BackendProvider"
          },
          "image": {
            "$ref": "#/components/schemas/BackendIdentifier"
          },
          "gpu_model": {
            "$ref": "#/components/schemas/BackendIdentifier"
          },
          "gpu_count": {
            "$ref": "#/components/schemas/PositiveInteger"
          },
          "num_nodes": {
            "$ref": "#/components/schemas/PositiveInteger"
          },
          "region": {
            "$ref": "#/components/schemas/BackendIdentifier"
          },
          "capacity_mode": {
            "type": "string",
            "enum": [
              "on_demand",
              "spot"
            ]
          },
          "workload_trust": {
            "type": "string",
            "enum": [
              "owner",
              "untrusted"
            ]
          },
          "max_hourly_price_microusd": {
            "$ref": "#/components/schemas/PositiveInteger"
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "unevaluatedProperties": {
          "not": {}
        }
      },
      "BackendWorkloadStatus": {
        "type": "object",
        "required": [
          "job_id",
          "state"
        ],
        "properties": {
          "job_id": {
            "$ref": "#/components/schemas/BackendIdentifier"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "canceled",
              "unknown"
            ]
          }
        },
        "unevaluatedProperties": {
          "not": {}
        }
      },
      "Interruption": {
        "type": "object",
        "required": [
          "schema_version",
          "interruption_id",
          "version",
          "phase",
          "source",
          "release_by_ms",
          "signal_at_ms"
        ],
        "properties": {
          "schema_version": {
            "type": "number",
            "enum": [
              1
            ]
          },
          "interruption_id": {
            "$ref": "#/components/schemas/InterruptionId"
          },
          "version": {
            "$ref": "#/components/schemas/PositiveInteger"
          },
          "phase": {
            "type": "string",
            "enum": [
              "scheduled",
              "releasing",
              "completed",
              "canceled"
            ]
          },
          "source": {
            "$ref": "#/components/schemas/InterruptionSourceNotice"
          },
          "release_by_ms": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NonnegativeInteger"
              },
              {
                "type": "null"
              }
            ]
          },
          "signal_at_ms": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NonnegativeInteger"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "unevaluatedProperties": {
          "not": {}
        },
        "allOf": [
          {
            "$ref": "#/components/schemas/InterruptionScope"
          }
        ]
      },
      "InterruptionAction": {
        "type": "string",
        "enum": [
          "ack",
          "ready",
          "request_extension"
        ]
      },
      "InterruptionEvent": {
        "type": "object",
        "required": [
          "specversion",
          "id",
          "source",
          "type",
          "subject",
          "datacontenttype",
          "data"
        ],
        "properties": {
          "specversion": {
            "type": "string",
            "enum": [
              "1.0"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^ice_[a-f0-9]{64}(?![\\s\\S])"
          },
          "source": {
            "type": "string",
            "enum": [
              "urn:vgpu:interruptions"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "com.vgpu.interruption.changed.v1"
            ]
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "datacontenttype": {
            "type": "string",
            "enum": [
              "application/json"
            ]
          },
          "data": {
            "$ref": "#/components/schemas/Interruption"
          }
        },
        "unevaluatedProperties": {
          "not": {}
        }
      },
      "InterruptionId": {
        "type": "string",
        "pattern": "^int_[a-f0-9]{32}(?![\\s\\S])"
      },
      "InterruptionReceipt": {
        "type": "object",
        "required": [
          "schema_version",
          "request_id",
