            ]
          },
          "credential": {
            "$ref": "#/components/schemas/SiteCredential"
          }
        },
        "unevaluatedProperties": {
          "not": {}
        }
      },
      "SiteId": {
        "type": "string",
        "pattern": "^sit_[a-f0-9]{32}(?![\\s\\S])"
      },
      "SiteRotationId": {
        "type": "string",
        "pattern": "^rot_[a-f0-9]{32}(?![\\s\\S])"
      },
      "SiteRotationResult": {
        "type": "object",
        "required": [
