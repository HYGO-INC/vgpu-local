          }
        },
        "unevaluatedProperties": {
          "not": {}
        },
        "allOf": [
          {
            "$ref": "#/components/schemas/SiteConnection"
          }
        ]
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "Bearer"
      }
    }
  }
