            "$ref": "#/components/schemas/SiteRotationId"
          },
          "credential": {
            "$ref": "#/components/schemas/SiteCredential"
          }
        },
        "unevaluatedProperties": {
          "not": {}
        }
      },
      "SiteEnrollment": {
        "type": "object",
        "required": [
          "site_id",
          "name",
          "protocol_version",
          "credential"
        ],
        "properties": {
          "site_id": {
            "$ref": "#/components/schemas/SiteId"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "protocol_version": {
            "type": "string",
            "enum": [
