// Connection enrollment is independent of cloud consumption and contribution.
using TypeSpec.Http;
namespace Vgpu.V1;

@pattern("^sit_[a-f0-9]{32}(?![\\s\\S])")
scalar SiteId extends string;

// 32 random bytes encoded as canonical, unpadded base64url, prefixed by vgs_.
// Never return this credential in a response or persist its plaintext server-side.
@pattern("^vgs_[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048](?![\\s\\S])")
scalar SiteCredential extends string;

@pattern("^rot_[a-f0-9]{32}(?![\\s\\S])")
scalar SiteRotationId extends string;

model SiteCredentialRotation {
  rotation_id: SiteRotationId;
  credential: SiteCredential;
}

model SiteEnrollment {
  site_id: SiteId;
  @minLength(1) @maxLength(120)
  name: string;
  protocol_version: "vgpu.site.v1";
  credential: SiteCredential;
}

model SiteConnection {
  site_id: SiteId;
  tenant_id: BackendIdentifier;
  project_id: BackendIdentifier;
  @minLength(1) @maxLength(120)
  name: string;
  protocol_version: "vgpu.site.v1";
  state: "active" | "expired" | "revoked";
  // Unix seconds, generated by the server; expiration is enforced on every call.
  credential_expires_at: NonnegativeInteger;
  consumption_enabled: false;
  contribution_enabled: false;
}

model SiteRotationResult extends SiteConnection {
  rotation_id: SiteRotationId;
}

model ProtocolError {
  @pattern("^[a-z][a-z0-9_]{0,63}(?![\\s\\S])")
  error: string;
}

alias FederationErrorResponse = {
  @statusCode statusCode: 400 | 401 | 403 | 404 | 409 | 413 | 415 | 503;
  @body body: ProtocolError;
};

@useAuth(BearerAuth)
@route("/api/v1/tenants/{tenant_id}/projects/{project_id}/sites")
interface SiteFederation {
  // Enrollment requires a user session and manage_sites permission.
  @post enroll(@path tenant_id: BackendIdentifier, @path project_id: BackendIdentifier,
    @body enrollment: SiteEnrollment): { @statusCode statusCode: 201; @body body: SiteConnection } | FederationErrorResponse;

  // Connection calls accept only this installation's scoped credential.
  @get @route("/{site_id}/connection")
  connection(@path tenant_id: BackendIdentifier, @path project_id: BackendIdentifier, @path site_id: SiteId): SiteConnection | FederationErrorResponse;

  // Old credentials can replay only this exact rotation while its new key is current.
  // A replay does not extend expiry; revoked/expired sites cannot rotate.
  @post @route("/{site_id}/connection/renew")
  renew(@path tenant_id: BackendIdentifier, @path project_id: BackendIdentifier, @path site_id: SiteId,
    @body rotation: SiteCredentialRotation): SiteRotationResult | FederationErrorResponse;

  @post @route("/{site_id}/connection/revoke")
  disconnect(@path tenant_id: BackendIdentifier, @path project_id: BackendIdentifier, @path site_id: SiteId): SiteConnection | FederationErrorResponse;

  // Owner revocation requires a user session and manage_sites permission.
  @post @route("/{site_id}/revoke")
  revoke(@path tenant_id: BackendIdentifier, @path project_id: BackendIdentifier, @path site_id: SiteId): SiteConnection | FederationErrorResponse;

  // Owner-authenticated management of explicitly approved local recipes. No rental.
  @post @route("/{site_id}/commands")
  command(@path tenant_id: BackendIdentifier, @path project_id: BackendIdentifier, @path site_id: SiteId,
    @body command: LocalExecutionCommand): LocalExecutionCommand | FederationErrorResponse;

  @get @route("/{site_id}/commands/{command_id}")
  commandStatus(@path tenant_id: BackendIdentifier, @path project_id: BackendIdentifier,
    @path site_id: SiteId, @path command_id: LocalCommandId): LocalCommandStatus | FederationErrorResponse;

  @get @route("/{site_id}/executions")
  // Latest 100 reports. Older identified reports remain available by ID.
  executions(@path tenant_id: BackendIdentifier, @path project_id: BackendIdentifier, @path site_id: SiteId): LocalExecutionReport[] | FederationErrorResponse;

  @get @route("/{site_id}/executions/{execution_id}")
  execution(@path tenant_id: BackendIdentifier, @path project_id: BackendIdentifier,
    @path site_id: SiteId, @path execution_id: LocalExecutionId): LocalExecutionReport | FederationErrorResponse;

  // The site credential is checked on every exchange, including result replay.
  @post @route("/{site_id}/connection/exchange")
  exchange(@path tenant_id: BackendIdentifier, @path project_id: BackendIdentifier, @path site_id: SiteId,
    @body exchange: LocalExchange): LocalExchangeResult | FederationErrorResponse;
}

@pattern("^lex_[a-f0-9]{32}(?![\\s\\S])")
scalar LocalExecutionId extends string;
@pattern("^cmd_[a-f0-9]{32}(?![\\s\\S])")
scalar LocalCommandId extends string;
@pattern("^[a-z][a-z0-9_-]{0,63}(?![\\s\\S])")
scalar LocalRecipeId extends string;
@pattern("^[a-f0-9]{64}(?![\\s\\S])")
scalar LocalDigest extends string;

model LocalExecutionCommand {
  command_id: LocalCommandId;
  tenant_id: BackendIdentifier;
  project_id: BackendIdentifier;
  site_id: SiteId;
  execution_id: LocalExecutionId;
  generation: PositiveInteger;
  expires_at: PositiveInteger;
  action: "start" | "cancel";
  recipe_id: LocalRecipeId;
  recipe_sha256: LocalDigest;
  // RFC 8785 SHA256 of every other field. This is an integrity check, not auth.
  request_sha256: LocalDigest;
}

model LocalCommandReceipt {
  command_id: LocalCommandId;
  request_sha256: LocalDigest;
  accepted: boolean;
  @pattern("^[a-z][a-z0-9_]{0,63}(?![\\s\\S])")
  error_code?: string;
}

model LocalCommandStatus {
  command: LocalExecutionCommand;
  receipt?: LocalCommandReceipt;
}

model LocalExecutionReport {
  execution_id: LocalExecutionId;
  revision: PositiveInteger;
  generation: PositiveInteger;
  state: "accepted" | "dispatching" | "queued" | "running" | "succeeded" | "failed" | "uncertain" | "cancel_requested" | "canceled";
  recipe_id: LocalRecipeId;
  recipe_sha256: LocalDigest;
  @pattern("^[a-z][a-z0-9_]{0,63}(?![\\s\\S])")
  error_code?: string;
}

model LocalExchange {
  @maxItems(20) receipts: LocalCommandReceipt[];
  @maxItems(20) reports: LocalExecutionReport[];
}

model LocalReportReceipt {
  execution_id: LocalExecutionId;
  revision: PositiveInteger;
}

model LocalExchangeResult {
  tenant_id: BackendIdentifier;
  project_id: BackendIdentifier;
  site_id: SiteId;
  @maxItems(20) commands: LocalExecutionCommand[];
  @maxItems(20) command_receipts: LocalCommandId[];
  @maxItems(20) report_receipts: LocalReportReceipt[];
}

// OAuth itself follows RFC 8628. These two product operations accept only its
// enrollment-scoped token, never an account session or a site's runtime key.
model SiteEnrollmentApproval {
  site_id: SiteId;
  tenant_id: BackendIdentifier;
  project_id: BackendIdentifier;
  @minLength(1) @maxLength(120)
  name: string;
}

@useAuth(BearerAuth)
@route("/api/v1/device")
interface DeviceEnrollment {
  @get @route("/approval")
  approval(): SiteEnrollmentApproval | FederationErrorResponse | {
    @statusCode statusCode: 429; @body body: ProtocolError;
  };
  @post @route("/enroll")
  enroll(@body enrollment: SiteEnrollment): {
    @statusCode statusCode: 201; @body body: SiteConnection;
  } | FederationErrorResponse | { @statusCode statusCode: 429; @body body: ProtocolError; };
}
