// Connection enrollment is independent of cloud consumption and contribution.
namespace Vgpu.V1;

@pattern("^sit_[a-f0-9]{32}(?![\\s\\S])")
scalar SiteId extends string;

// 32 random bytes encoded as canonical, unpadded base64url, prefixed by vgs_.
// Never return this credential in a response or persist its plaintext server-side.
@pattern("^vgs_[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048](?![\\s\\S])")
scalar SiteCredential extends string;

model SiteEnrollment {
  site_id: SiteId;
  @minLength(1) @maxLength(120)
  name: string;
  protocol_version: "vgpu.site.v1";
  credential: SiteCredential;
}

model SiteConnection {
  site_id: SiteId;
  tenant_id: BackendIdentifier;
  project_id: BackendIdentifier;
  @minLength(1) @maxLength(120)
  name: string;
  protocol_version: "vgpu.site.v1";
  state: "active" | "expired" | "revoked";
  // Unix seconds, generated by the server; expiration is enforced on every call.
  credential_expires_at: NonnegativeInteger;
  consumption_enabled: false;
  contribution_enabled: false;
}
