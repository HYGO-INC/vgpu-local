{
  "schemaVersion": 1,
  "version": "1.0.0",
  "profiles": ["hosted-websocket", "local-http-bearer"],
  "baseHeaders": {"Host": ["{authority}"], "Origin": ["{allowed_origin}"], "Authorization": ["Bearer {token}"]},
  "cases": [
    {"id": "trusted-browser", "headers": {}, "allow": {"hosted-websocket": true, "local-http-bearer": true}},
    {"id": "native-client", "headers": {"Origin": []}, "allow": {"hosted-websocket": true, "local-http-bearer": true}},
    {"id": "native-client-without-token", "headers": {"Origin": [], "Authorization": []}, "allow": {"hosted-websocket": true, "local-http-bearer": false}},
    {"id": "untrusted-origin", "headers": {"Origin": ["https://attacker.example"]}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "opaque-origin", "headers": {"Origin": ["null"]}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "empty-origin", "headers": {"Origin": [""]}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "origin-suffix", "headers": {"Origin": ["{allowed_origin}.attacker.example"]}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "origin-userinfo", "headers": {"Origin": ["{allowed_origin}@attacker.example"]}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "origin-path", "headers": {"Origin": ["{allowed_origin}/"]}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "origin-query", "headers": {"Origin": ["{allowed_origin}?trusted=true"]}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "origin-fragment", "headers": {"Origin": ["{allowed_origin}#trusted"]}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "origin-list-space", "headers": {"Origin": ["{allowed_origin} https://attacker.example"]}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "origin-list-comma", "headers": {"Origin": ["{allowed_origin}, https://attacker.example"]}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "duplicate-origin-trusted-first", "headers": {"Origin": ["{allowed_origin}", "https://attacker.example"]}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "duplicate-origin-trusted-last", "headers": {"Origin": ["https://attacker.example", "{allowed_origin}"]}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "duplicate-origin-identical", "headers": {"Origin": ["{allowed_origin}", "{allowed_origin}"]}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "wrong-scheme", "headers": {"Origin": ["{other_scheme_origin}"]}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "wrong-origin-port", "headers": {"Origin": ["{other_port_origin}"]}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "rebinding-host", "headers": {"Host": ["attacker.example:{port}"]}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "rebinding-without-origin", "headers": {"Host": ["attacker.example:{port}"], "Origin": []}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "missing-host", "headers": {"Host": []}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "empty-host", "headers": {"Host": [""]}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "wrong-host-port", "headers": {"Host": ["127.0.0.1:1"]}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "host-without-port", "headers": {"Host": ["127.0.0.1"]}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "host-userinfo", "headers": {"Host": ["127.0.0.1@attacker.example:{port}"]}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "host-suffix", "headers": {"Host": ["127.0.0.1.attacker.example:{port}"]}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "host-trailing-dot", "headers": {"Host": ["127.0.0.1.:{port}"]}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "host-alternate-address", "headers": {"Host": ["2130706433:{port}"]}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "duplicate-host-trusted-first", "headers": {"Host": ["{authority}", "attacker.example:{port}"]}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "duplicate-host-trusted-last", "headers": {"Host": ["attacker.example:{port}", "{authority}"]}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "duplicate-host-identical", "headers": {"Host": ["{authority}", "{authority}"]}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "localhost-compatibility", "headers": {"Host": ["localhost:{port}"]}, "allow": {"hosted-websocket": true, "local-http-bearer": false}},
    {"id": "forwarded-host-cannot-authorize", "headers": {"Host": ["attacker.example:{port}"], "X-Forwarded-Host": ["{authority}"], "Forwarded": ["host={authority};proto=http"]}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "forwarded-origin-cannot-authorize", "headers": {"Origin": ["https://attacker.example"], "X-Forwarded-Origin": ["{allowed_origin}"]}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "header-names-case-insensitive", "headers": {"hOsT": ["{authority}"], "oRiGiN": ["{allowed_origin}"], "aUtHoRiZaTiOn": ["Bearer {token}"]}, "allow": {"hosted-websocket": true, "local-http-bearer": true}},
    {"id": "cross-site-metadata", "headers": {"Sec-Fetch-Site": ["cross-site"]}, "allow": {"hosted-websocket": true, "local-http-bearer": false}},
    {"id": "same-origin-metadata", "headers": {"Sec-Fetch-Site": ["same-origin"]}, "allow": {"hosted-websocket": true, "local-http-bearer": true}},
    {"id": "same-origin-metadata-cannot-authorize", "headers": {"Origin": ["https://attacker.example"], "Sec-Fetch-Site": ["same-origin"]}, "allow": {"hosted-websocket": false, "local-http-bearer": false}},
    {"id": "missing-bearer", "headers": {"Authorization": []}, "allow": {"local-http-bearer": false}},
    {"id": "wrong-bearer", "headers": {"Authorization": ["Bearer wrong-token"]}, "allow": {"local-http-bearer": false}},
    {"id": "basic-is-not-bearer", "headers": {"Authorization": ["Basic {token}"]}, "allow": {"local-http-bearer": false}},
    {"id": "duplicate-bearer-valid-first", "headers": {"Authorization": ["Bearer {token}", "Bearer wrong-token"]}, "allow": {"local-http-bearer": false}},
    {"id": "duplicate-bearer-valid-last", "headers": {"Authorization": ["Bearer wrong-token", "Bearer {token}"]}, "allow": {"local-http-bearer": false}},
    {"id": "duplicate-bearer-identical", "headers": {"Authorization": ["Bearer {token}", "Bearer {token}"]}, "allow": {"local-http-bearer": false}},
    {"id": "duplicate-fetch-site", "headers": {"Sec-Fetch-Site": ["same-origin", "cross-site"]}, "allow": {"local-http-bearer": false}}
  ]
}
